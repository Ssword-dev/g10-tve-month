{
  "private": true,
  "name": "@project/app",
  "version": "1.0.0",
  "description": "Minimal Electron application",
  "main": "main.js",
  "productName": "SPRCNHS SEMS",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.example.standaloneapp",
    "directories": {
      "output": "../../artifacts/standalone/app"
    },
    "win": {
      "target": "dir"
    },
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "../../runtime",
        "to": "runtime",
        "filter": ["**/*"]
      },
      {
        "from": "../../backend",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "../../artifacts/frontend",
        "to": "frontend",
        "filter": ["**/*"]
      }
    ]
  }
}
